# GoldMasters environment template (D-36; Schema.md line 244).
# Copy to `.env` and fill in real values. Secret keys stay empty here —
# secrets arrive only through GOLDMASTERS_-prefixed variables, never commits.
GOLDMASTERS_BIND_HOST=127.0.0.1
GOLDMASTERS_BIND_PORT=8000
GOLDMASTERS_DATABASE_URL=postgresql+psycopg://goldmasters:CHANGE_ME@127.0.0.1:5432/goldmasters
GOLDMASTERS_TRACE_FILE_PATH=logs/traces.jsonl
GOLDMASTERS_LOG_LEVEL=INFO
GOLDMASTERS_CONFIG_VERSION=1.0
GOLDMASTERS_PROVIDER_API_KEY=
GOLDMASTERS_PROVIDER_ID=mt5
GOLDMASTERS_INSTRUMENT_ID=xauusd
GOLDMASTERS_MT5_SYMBOL=XAUUSD
GOLDMASTERS_TIMEFRAME=H1
GOLDMASTERS_MT5_SERVER_TIMEZONE=
GOLDMASTERS_MT5_PROBE_TIMEOUT_SECONDS=2.0
GOLDMASTERS_MT5_STARTUP_TIMEOUT_SECONDS=10.0
GOLDMASTERS_MT5_TERMINAL_PATH=
GOLDMASTERS_MT5_RETRY_ATTEMPTS=1
GOLDMASTERS_MT5_RETRY_DELAY_MS=500
GOLDMASTERS_MT5_BARS_COUNT=10
GOLDMASTERS_BAR_STALE_CLOSED_BARS=2
GOLDMASTERS_BAR_STALE_GRACE_SECONDS=300
GOLDMASTERS_QUOTE_STALE_SECONDS_OVERLAP=30
GOLDMASTERS_QUOTE_STALE_SECONDS_MAJOR=60
GOLDMASTERS_QUOTE_STALE_SECONDS_ASIA=180
GOLDMASTERS_QUOTE_STALE_SECONDS_OFFHOURS=300
GOLDMASTERS_WEEKEND_CLOSE_UTC=
GOLDMASTERS_DAILY_BREAK_UTC=
GOLDMASTERS_SESSION_OVERLAP_UTC=
GOLDMASTERS_SESSION_MAJOR_UTC=
GOLDMASTERS_SESSION_ASIA_UTC=
GOLDMASTERS_TICK_ROUNDING_MODE=ROUND_HALF_UP
GOLDMASTERS_MAX_RISK_PERCENT_PER_IDEA=0.5
GOLDMASTERS_MIN_RISK_REWARD_RATIO=2.0
# Phase 3.1 strategy-agent scaffold: fail-closed until the operator sets
