# Phase 4 graph bounds (D-4.2): locked defaults apply when unset; an invalid
# value fails startup. Concurrency unset means no explicit cap (fan-out is
# still capped at the eligible set by construction).
GOLDMASTERS_GRAPH_NODE_TIMEOUT_SECONDS=60
GOLDMASTERS_GRAPH_NODE_MAX_RETRIES=2
GOLDMASTERS_GRAPH_MAX_CONCURRENCY=
# Phase 6 cost model (D-6.1): spread/commission/slippage/swap in price units.
# Leave empty = unconfigured (fail-closed). A value of "0" means explicitly
# zero cost, which is different from unset.
GOLDMASTERS_COST_SPREAD=0.05
GOLDMASTERS_COST_COMMISSION=3.50
GOLDMASTERS_COST_SLIPPAGE=0.10
GOLDMASTERS_COST_SWAP=2.50
GOLDMASTERS_COST_PROFILES={"xauusd":{"spread":"0.30","commission":"3.50","slippage":"0.10","swap":"2.50","confirmed":true},"btcusd":{"spread":"0.0005","commission":"1.00","slippage":"0.001","swap":"5.00","confirmed":true}}
# Phase 4 model runtime (04-03): loopback-only endpoint; model id unset until
# T0004 closes — discovery fails the run closed without it.
GOLDMASTERS_OLLAMA_HOST=http://127.0.0.1:11434
GOLDMASTERS_OLLAMA_MODEL=gemma:2b
