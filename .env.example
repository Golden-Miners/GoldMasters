# GoldMasters environment template (D-36; Schema.md line 244).
# Copy to `.env` and fill in real values. Secret keys stay empty here —
# secrets arrive only through GOLDMASTERS_-prefixed variables, never commits.
GOLDMASTERS_BIND_HOST=127.0.0.1
GOLDMASTERS_BIND_PORT=8000
GOLDMASTERS_DATABASE_URL=postgresql+psycopg://goldmasters:CHANGE_ME@127.0.0.1:5432/goldmasters
GOLDMASTERS_TRACE_FILE_PATH=logs/traces.jsonl
GOLDMASTERS_LOG_LEVEL=INFO
GOLDMASTERS_CONFIG_VERSION=1.0
GOLDMASTERS_PROVIDER_API_KEY=
