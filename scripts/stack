#!/bin/sh
# GoldMasters local stack: database + backend together on loopback (D-33).
#
#   sh scripts/stack          # provision/init if needed, start DB, launch API
#   sh scripts/stack --stop   # stop the API and the database
#
# Both legs bind loopback explicitly; the API leg reuses the validated
# settings (plan 08) and its own startup guard rejects a non-loopback bind.
# The migration leg tolerates an absent migration tree (plan 06 adds it).
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PS="powershell -NoProfile -ExecutionPolicy Bypass -File"

if [ "${1:-}" = "--stop" ]; then
  echo "Stopping GoldMasters stack..."
  $PS "$ROOT/scripts/postgres/stop.ps1" || true
  echo "Stack stopped."
  exit 0
fi

$PS "$ROOT/scripts/postgres/provision.ps1"
$PS "$ROOT/scripts/postgres/init.ps1"
$PS "$ROOT/scripts/postgres/start.ps1"

if [ -d "$ROOT/apps/api/migrations" ]; then
  echo "Applying migrations..."
  (cd "$ROOT" && uv run alembic -c apps/api/alembic.ini upgrade head)
else
  echo "No migration tree yet (plan 06 adds it); skipping."
fi

echo "Starting API on loopback..."
cd "$ROOT" && uv run uvicorn goldmasters_api.app:app --host 127.0.0.1 --port 8000
