{
  "$defs": {
    "AgentRunStatus": {
      "description": "Schema.md \u00a72 agent/run status.",
      "enum": [
        "queued",
        "running",
        "ok",
        "no_setup",
        "insufficient_data",
        "skipped",
        "error",
        "timed_out",
        "cancelled"
      ],
      "title": "AgentRunStatus",
      "type": "string"
    },
    "ErrorCode": {
      "description": "The closed, stable, machine-readable error-code vocabulary (D-23).",
      "enum": [
        "CONTRACT_VALIDATION_FAILED",
        "UNKNOWN_CONTRACT_MAJOR",
        "CONFIG_INVALID",
        "UNSUPPORTED_INSTRUMENT",
        "UNSUPPORTED_TIMEFRAME",
        "INTERNAL_ERROR"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorPayload": {
      "additionalProperties": false,
      "description": "Schema.md \u00a710, field for field: the sanitized C-09 error object.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Details"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "correlation_id",
        "details"
      ],
      "title": "ErrorPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema.md \u00a73, field for field \u2014 and no field more.",
  "properties": {
    "agent_name": {
      "title": "Agent Name",
      "type": "string"
    },
    "agent_version": {
      "title": "Agent Version",
      "type": "string"
    },
    "as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "As Of"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorPayload"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "input_refs": {
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "result": {
      "additionalProperties": true,
      "title": "Result",
      "type": "object"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.\\d+(\\.\\d+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentRunStatus"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "agent_name",
    "agent_version",
    "status",
    "created_at",
    "as_of",
    "input_refs",
    "evidence_refs",
    "limitations",
    "error",
    "result"
  ],
  "title": "Envelope",
  "type": "object"
}
